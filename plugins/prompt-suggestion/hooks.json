{
  "prompt-suggestion-shortcut": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./hooks/intercept-shortcut.mjs",
        "timeout": 5
      }
    ]
  },
  "prompt-suggestion-generator": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "node ./hooks/generate-suggestion.mjs",
        "timeout": 5
      }
    ]
  }
}
