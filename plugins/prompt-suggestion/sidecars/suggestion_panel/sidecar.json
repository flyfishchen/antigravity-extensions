{
  "command": "node",
  "args": ["main.mjs"],
  "restart_policy": "always",
  "display_name": "Prompt Suggestions",
  "description": "Zero-token heuristic follow-up prompt suggestions with one-click send, copy, and per-session controls.",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": false
  },
  "ui_config": {
    "display_name": "Prompt Suggestions",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "Prompt Suggestions"
      },
      {
        "path": "/global",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_SIDEBAR",
        "title": "Prompt Suggestions"
      }
    ]
  }
}
