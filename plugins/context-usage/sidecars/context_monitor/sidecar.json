{
  "command": "node",
  "args": ["main.mjs"],
  "restart_policy": "always",
  "display_name": "Context Usage",
  "description": "Live LLM context window gauge, category breakdown, turn-by-turn token growth chart, cache efficiency, estimated API cost & savings, and subagent usage.",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": false
  },
  "ui_config": {
    "display_name": "Context Usage",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "Context Usage"
      },
      {
        "path": "/global",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_SIDEBAR",
        "title": "Context Usage"
      }
    ]
  }
}
